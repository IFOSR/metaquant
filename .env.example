# PostgreSQL bootstrap account (Docker only)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
POSTGRES_BOOTSTRAP_DB=postgres
POSTGRES_PORT=55432

# Application databases
QUANT_DB_USER=quant_app
QUANT_DB_PASSWORD=quant_app_dev
QUANT_DB_NAME=quant_platform
DATABASE_URL=postgresql+psycopg://quant_app:quant_app_dev@localhost:55432/quant_platform

# MinIO
MINIO_ROOT_USER=quant_minio
MINIO_ROOT_PASSWORD=quant_minio_dev
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=quant_minio
MINIO_SECRET_KEY=quant_minio_dev
MINIO_BUCKET=artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local service ports
API_PORT=8091

# iFinD（同花顺）数据源凭证；配置后采集脚本 --source auto 优先走 iFinD（FORMAL）
IFIND_REFRESH_TOKEN=
